# API Keys for LLM providers
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk-xxxxxxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Logging configuration
FEI_LOG_LEVEL=INFO
FEI_LOG_FILE=~/.fei.log

# Default provider and model
PROVIDER=anthropic
MODEL=claude-3-7-sonnet-20250219

# --- Model Optimizer Settings ---
# Enable/disable the dynamic model optimizer (default: false)
# FEI_OPTIMIZER_ENABLED=true

# Optimization strategy (default: cost)
# Options: cost, latency, cost_performance_ratio (latency/ratio not yet implemented)
# FEI_OPTIMIZER_STRATEGY=cost

# Allowed providers for optimization (comma-separated, empty means all with keys)
# Example: FEI_OPTIMIZER_ALLOWED_PROVIDERS=openai,groq
# FEI_OPTIMIZER_ALLOWED_PROVIDERS=

# Models to exclude from optimization (comma-separated)
# Example: FEI_OPTIMIZER_MODEL_BLACKLIST=openai/gpt-3.5-turbo,groq/llama3-8b-8192
# FEI_OPTIMIZER_MODEL_BLACKLIST=

# How often to refresh model cost/availability data (seconds, default: 3600)
# FEI_OPTIMIZER_UPDATE_INTERVAL=3600
